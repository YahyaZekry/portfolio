---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
const headingId = `${id}-heading`;
---

<section id={id} class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-6" aria-labelledby={headingId}>
  <!-- Small sticky label on mobile; the heading itself carries the desktop layout. -->
  <div class="sticky top-0 z-20 -mx-6 mb-6 border-b border-line bg-canvas/80 px-6 py-4 backdrop-blur-sm md:-mx-12 md:px-12 lg:static lg:mx-0 lg:mb-8 lg:border-none lg:bg-transparent lg:p-0 lg:backdrop-blur-none">
    <h2 class="text-xs font-bold tracking-widest text-soft uppercase lg:text-2xl lg:font-semibold lg:tracking-[-0.02em] lg:text-ink lg:normal-case">
      {title}
    </h2>
  </div>
  <slot />
</section>
