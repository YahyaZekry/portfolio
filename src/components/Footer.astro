---
import RichText from './RichText.astro';
import { profile, ui } from '../data/profile';
---

<footer class="max-w-md pb-16 sm:pb-0">
  <div data-reveal>
    <h2 class="text-2xl font-semibold tracking-[-0.02em] text-ink">{ui.contact.title}</h2>
    <p class="mt-3 text-sm leading-normal text-soft">{ui.contact.body}</p>
    <a
      class="group/link mt-5 inline-flex items-baseline text-xl font-semibold tracking-tight text-ink transition-colors hover:text-accent focus-visible:text-accent motion-reduce:transition-none sm:text-2xl"
      href={`mailto:${profile.email}`}
    >
      <span class="border-b border-line-strong pb-0.5 transition group-hover/link:border-accent group-focus-visible/link:border-accent motion-reduce:transition-none">
        {profile.email}
      </span>
    </a>
  </div>
  <RichText
    source={ui.footer}
    class="mt-12 text-xs leading-normal text-muted"
    linkClass="font-medium text-soft transition-colors hover:text-accent focus-visible:text-accent motion-reduce:transition-none"
  />
</footer>
