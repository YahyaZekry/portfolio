---
import Icon from './Icon.astro';
import { nlDemo } from '../data/profile';

const chips = [
  { id: 'beds', label: 'beds' },
  { id: 'type', label: 'type' },
  { id: 'city', label: 'city' },
  { id: 'price', label: 'max price' },
];
---

<div class="relative rounded-xl border border-line bg-surface p-4 card-edge sm:p-6" data-nl-demo data-reveal>
  <p class="font-mono text-xs text-muted">{nlDemo.kicker}</p>

  <div class="mt-4 grid items-start gap-6 lg:grid-cols-[1fr_auto_1.1fr]">
    <div>
      <label for="nl-demo-input" class="text-xs font-medium text-soft">
        {nlDemo.inputLabel}
      </label>
      <div class="relative mt-2 rounded-lg border border-line bg-canvas">
        <div
          aria-hidden="true"
          class="nl-mirror pointer-events-none overflow-hidden px-3 py-2.5 text-sm whitespace-pre"
          data-nl-mirror
        ></div>
        <input
          id="nl-demo-input"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder={nlDemo.placeholder}
          class="absolute inset-0 w-full bg-transparent px-3 py-2.5 text-sm text-transparent caret-accent placeholder:text-muted"
        />
      </div>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {nlDemo.examples.map((example) => (
          <button
            type="button"
            class="shrink-0 rounded-full border border-line px-2.5 py-1 font-mono text-[11px] whitespace-nowrap text-muted transition-colors hover:border-accent/50 hover:text-accent focus-visible:border-accent motion-reduce:transition-none"
            data-nl-example={example}
          >
            {example}
          </button>
        ))}
      </div>
    </div>

    <div class="hidden items-center self-center text-muted lg:flex" aria-hidden="true">
      <span class="h-px w-8 bg-line-strong"></span>
      <Icon name="arrow-right" class="h-4 w-4" />
    </div>

    <div>
      <p class="text-xs font-medium text-soft">{nlDemo.outputLabel}</p>
      <div class="mt-2 flex min-h-9 flex-wrap gap-2" aria-live="polite">
        {chips.map(({ id, label }) => (
          <span
            class="rounded-full border border-line px-3 py-1.5 font-mono text-xs text-muted"
            data-nl-chip={id}
            data-label={label}
          >
            {label}
          </span>
        ))}
      </div>
    </div>
  </div>

  <p class="mt-5 text-xs text-muted">{nlDemo.hint}</p>
</div>

<script>
  // Local heuristic parser: same shape the real pipeline would hand to
  // Postgres. Vocabulary is intentionally small and honest about it.
  const root = document.querySelector<HTMLElement>('[data-nl-demo]');

  const CITIES = ['abu dhabi', 'dubai', 'sharjah', 'london', 'manchester', 'birmingham'];
  const TYPES: [RegExp, string][] = [
    [/\b(?:flats?|apartments?)\b/, 'flat'],
    [/\bvillas?\b/, 'villa'],
    [/\btownhous(?:e|es)\b/, 'townhouse'],
    [/\bstudios?\b/, 'studio'],
    [/\bpenthouses?\b/, 'penthouse'],
  ];
  const WORD_BEDS: Record<string, string> = {
    one: '1',
    two: '2',
    three: '3',
    four: '4',
    five: '5',
    six: '6',
    seven: '7',
    eight: '8',
  };

  function compact(value: number): string {
    if (value >= 1e6) return `${String(Math.round(value / 1e5) / 10).replace(/\.0$/, '')}M`;
    if (value >= 1e3) return `${String(Math.round(value / 100) / 10).replace(/\.0$/, '')}K`;
    return String(value);
  }

  // Values for the chips plus the source ranges, so the input can highlight
  // what was understood.
  function analyze(text: string): { values: Record<string, string | null>; ranges: [number, number][] } {
    const values: Record<string, string | null> = { beds: null, type: null, city: null, price: null };
    const ranges: [number, number][] = [];
    const q = text.toLowerCase();

    let beds =
      q.match(/\b(\d)\s*-?\s*(?:bed|bedroom|br)\b/) ??
      Object.keys(WORD_BEDS).reduce<RegExpMatchArray | null>(
        (hit, word) => hit ?? (q.match(new RegExp(`\\b${word}\\s*-?\\s*bed`)) && [word, WORD_BEDS[word]]),
        null,
      );
    if (beds) {
      values.beds = beds[1];
      ranges.push([beds.index!, beds.index! + beds[0].length]);
    }

    for (const [re, name] of TYPES) {
      const m = q.match(re);
      if (m) {
        values.type = name;
        ranges.push([m.index!, m.index! + m[0].length]);
        break;
      }
    }

    const city = CITIES.find((c) => q.includes(c));
    if (city) {
      values.city = city.replace(/\b\w/g, (ch) => ch.toUpperCase());
      const at = q.indexOf(city);
      ranges.push([at, at + city.length]);
    }

    const price =
      q.match(/(?:under|below|less than|up to|max(?:imum)?|≤|<)\s*(?:aed|gbp|£|\$)?\s*([\d.,]+)\s*(k|m|million)?\b/) ??
      q.match(/(?:aed|gbp|£|\$)\s*([\d.,]+)\s*(k|m|million)?\b/) ??
      q.match(/\b([\d.,]+)\s*(k|m|million)\b/);
    if (price) {
      const value =
        parseFloat(price[1].replace(/,/g, '')) * (price[2]?.startsWith('m') ? 1e6 : price[2] === 'k' ? 1e3 : 1);
      if (!Number.isNaN(value)) {
        values.price = `≤ ${compact(value)}`;
        ranges.push([price.index!, price.index! + price[0].length]);
      }
    }

    return { values, ranges };
  }

  if (root) {
    const input = root.querySelector<HTMLInputElement>('#nl-demo-input');
    const mirror = root.querySelector<HTMLElement>('[data-nl-mirror]');
    const chipEls = new Map(
      [...root.querySelectorAll<HTMLElement>('[data-nl-chip]')].map((el) => [el.dataset.nlChip!, el]),
    );
    const searchesNode = document.querySelector<HTMLElement>('[data-schema-table="searches"]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let last = '';
    let wasOn = false;
    let playTimer = 0;

    function stopPlayback() {
      if (playTimer) {
        clearInterval(playTimer);
        playTimer = 0;
      }
    }

    function render(text: string) {
      if (text === last) return;
      last = text;
      const { values, ranges } = analyze(text);

      for (const [id, el] of chipEls) {
        const value = values[id];
        const next = value ? `${el.dataset.label}: ${value}` : el.dataset.label!;
        if (el.textContent !== next) {
          el.textContent = next;
          el.classList.remove('chip-pop');
          void el.offsetWidth;
          el.classList.add('chip-pop');
        }
        el.classList.toggle('chip-on', Boolean(value));
      }

      // Mirror the input with the understood fragments highlighted.
      if (mirror) {
        mirror.replaceChildren();
        let cursor = 0;
        const sorted = [...ranges].sort((a, b) => a[0] - b[0]);
        for (const [start, end] of sorted) {
          if (start < cursor) continue;
          if (start > cursor) {
            const plain = document.createElement('span');
            plain.className = 'nl-plain';
            plain.textContent = text.slice(cursor, start);
            mirror.append(plain);
          }
          const hit = document.createElement('span');
          hit.className = 'nl-hit';
          hit.textContent = text.slice(start, end);
          mirror.append(hit);
          cursor = end;
        }
        if (cursor < text.length) {
          const plain = document.createElement('span');
          plain.className = 'nl-plain';
          plain.textContent = text.slice(cursor);
          mirror.append(plain);
        }
        mirror.scrollLeft = input?.scrollLeft ?? 0;
      }

      // A query that just resolved lights the searches row it belongs to.
      const on = Object.values(values).some(Boolean);
      if (on && !wasOn && searchesNode) {
        searchesNode.classList.add('schema-node-flash');
        setTimeout(() => searchesNode.classList.remove('schema-node-flash'), 800);
      }
      wasOn = on;
    }

    function playExample(text: string) {
      stopPlayback();
      if (reducedMotion.matches) {
        input!.value = text;
        render(text);
        return;
      }
      let i = 0;
      input!.value = '';
      render('');
      playTimer = window.setInterval(() => {
        i = Math.min(text.length, i + 1 + Math.floor(Math.random() * 2));
        input!.value = text.slice(0, i);
        render(input!.value);
        if (i >= text.length) stopPlayback();
      }, 34);
    }

    input?.addEventListener('input', () => {
      // A keystroke hands control back to the reader.
      stopPlayback();
      render(input.value);
    });
    input?.addEventListener('scroll', () => {
      if (mirror) mirror.scrollLeft = input.scrollLeft;
    });
    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-nl-example]')) {
      button.addEventListener('click', () => playExample(button.dataset.nlExample!));
    }
  }
</script>

<style>
  :global(.chip-on) {
    border-color: color-mix(in oklab, var(--color-accent) 55%, transparent);
    background: color-mix(in oklab, var(--color-accent) 10%, transparent);
    color: var(--color-accent);
  }
</style>
