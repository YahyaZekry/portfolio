---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Tags from './Tags.astro';
import { ui, type Project } from '../data/profile';

interface Props {
  item: Project;
  index: number;
}

const { name, href, summary, image, imageAlt, tags } = Astro.props.item;
const { index } = Astro.props;
const flip = index % 2 === 1;
---

<li class="group mb-16 last:mb-0 lg:mb-20" data-reveal>
  <div class="grid gap-6 sm:grid-cols-5 sm:items-center sm:gap-10">
    <a
      href={href}
      target="_blank"
      rel="noreferrer noopener"
      class={`block overflow-hidden rounded-xl sm:col-span-2 ${flip ? 'sm:order-2' : 'sm:order-1'}`}
      data-reveal="wipe"
    >
      <Image
        src={image}
        alt={imageAlt}
        widths={[400, 600, 900]}
        sizes="(min-width: 1280px) 240px, (min-width: 640px) 38vw, calc(100vw - 3rem)"
        class="aspect-[16/10] w-full border border-line object-cover object-top group-hover:border-line-strong"
        loading="lazy"
        decoding="async"
      />
    </a>
    <div class={flip ? 'sm:order-1 sm:col-span-3' : 'sm:order-2 sm:col-span-3'}>
      <h3>
        <a
          class="group/link inline-flex items-baseline text-lg font-semibold tracking-tight text-ink transition-colors hover:text-accent focus-visible:text-accent motion-reduce:transition-none"
          href={href}
          target="_blank"
          rel="noreferrer noopener"
        >
          {name}
          <Icon
            name="arrow-up-right"
            class="ml-1 inline-block h-4 w-4 shrink-0 translate-y-px transition-transform group-hover/link:-translate-y-1 group-hover/link:translate-x-1 group-focus-visible/link:-translate-y-1 group-focus-visible/link:translate-x-1 motion-reduce:transition-none"
          />
          <span class="sr-only">{ui.newTab}</span>
        </a>
      </h3>
      <p class="mt-2 text-sm leading-normal text-soft">{summary}</p>
      <Tags tags={tags} />
    </div>
  </div>
</li>
