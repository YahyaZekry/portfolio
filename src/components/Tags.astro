---
import { ui } from '../data/profile';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<ul class="mt-3 flex flex-wrap" aria-label={ui.tagsLabel}>
  {tags.map((tag) => (
    <li class="mr-1.5 mt-2">
      <div class="rounded-full border border-line px-3 py-1 text-xs font-medium leading-5 text-soft">{tag}</div>
    </li>
  ))}
</ul>
