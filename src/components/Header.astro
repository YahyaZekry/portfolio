---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { profile, socials, ui } from '../data/profile';

interface Props {
  sections: { id: string; title: string }[];
}

const { sections } = Astro.props;
---

<header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-[48%] lg:flex-col lg:justify-between lg:py-24">
  <div>
    <div class="rail-enter w-max" data-tilt>
      <Image
        src={profile.photo.src}
        alt={profile.photo.alt}
        widths={[256, 512]}
        sizes="112px"
        class="portrait-tilt h-28 w-28 rounded-xl border border-line object-cover card-edge"
        loading="eager"
        decoding="async"
      />
    </div>
    <h1 class="rail-enter mt-7 text-4xl font-semibold tracking-[-0.025em] text-ink sm:text-5xl">
      <a href="/">{profile.name}</a>
    </h1>
    <p class="rail-enter mt-3 text-lg font-medium tracking-tight text-ink">{profile.title}</p>
    <p class="rail-enter mt-4 max-w-xs leading-normal text-soft">{profile.tagline}</p>

    <nav class="hidden lg:block" aria-label={ui.navLabel}>
      <ul class="relative mt-16 w-max" data-nav-list>
        <span aria-hidden="true" class="absolute top-0 left-0 h-full w-px bg-line"></span>
        <span
          aria-hidden="true"
          class="absolute top-0 left-0 h-full w-px origin-top scale-y-0 bg-accent"
          data-nav-progress
        ></span>
        {sections.map(({ id, title }) => (
          <li>
            <a class="group flex items-center py-3 pl-4" href={`#${id}`} data-nav-link={id}>
              <span class="mr-4 h-px w-8 bg-line-strong transition-all group-hover:w-16 group-hover:bg-ink group-focus-visible:w-16 group-focus-visible:bg-ink group-data-active:w-16 group-data-active:bg-accent motion-reduce:transition-none" />
              <span class="text-xs font-bold uppercase tracking-widest text-muted transition-colors group-hover:text-ink group-focus-visible:text-ink group-data-active:text-ink motion-reduce:transition-none">
                {title}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <ul class="ml-1 mt-8 flex items-center" aria-label={ui.socialLabel}>
    {socials.map(({ label, href, icon }) => {
      const external = href.startsWith('http');
      return (
        <li class="mr-5 shrink-0 text-xs">
          <a
            class="-m-2.5 block p-2.5 text-soft transition-colors hover:text-ink focus-visible:text-ink motion-reduce:transition-none"
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noreferrer noopener' : undefined}
          >
            <span class="sr-only">{external ? `${label}${ui.newTab}` : label}</span>
            <Icon name={icon} class="h-6 w-6" />
          </a>
        </li>
      );
    })}
    <li class="shrink-0 text-xs">
      <button
        type="button"
        class="theme-toggle -m-2.5 block cursor-pointer p-2.5 text-soft transition-colors hover:text-ink focus-visible:text-ink motion-reduce:transition-none"
        data-theme-toggle
        aria-label="Toggle color theme"
      >
        <Icon name="sun" class="icon-sun h-6 w-6" />
        <Icon name="moon" class="icon-moon h-6 w-6" />
      </button>
    </li>
  </ul>
</header>

<style>
  /* Tilt is pointer-gated; the vars are only ever written by the script below. */
  .portrait-tilt {
    transform: perspective(600px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .portrait-tilt {
      transition: transform 160ms ease-out;
      will-change: transform;
    }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const sections = links
    .map((link) => document.getElementById(link.dataset.navLink!))
    .filter((section): section is HTMLElement => section !== null);
  const last = sections[sections.length - 1];
  const progress = document.querySelector<HTMLElement>('[data-nav-progress]');

  let frame = 0;
  const update = () => {
    frame = 0;
    const threshold = window.innerHeight / 3;
    let active = sections[0];
    if (window.scrollY > 0) {
      for (const section of sections) {
        const { top, bottom } = section.getBoundingClientRect();
        // A short last section never reaches the top third, so it counts once it is fully in view.
        if (top <= threshold || (section === last && bottom <= window.innerHeight)) active = section;
      }
    }
    for (const link of links) {
      const isActive = link.dataset.navLink === active?.id;
      link.toggleAttribute('data-active', isActive);
      if (isActive) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
    if (progress) {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.transform = `scaleY(${max > 0 ? (window.scrollY / max).toFixed(4) : 0})`;
    }
  };

  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(update);
  };

  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  update();

  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  const portrait = tilt?.querySelector('img');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const systemLight = window.matchMedia('(prefers-color-scheme: light)');
  toggle?.addEventListener('click', () => {
    const resolved = document.documentElement.dataset.theme ?? (systemLight.matches ? 'light' : 'dark');
    const next = resolved === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });

  if (tilt && portrait && finePointer.matches) {
    tilt.addEventListener(
      'pointermove',
      (event) => {
        if (reducedMotion.matches) return;
        const rect = tilt.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        portrait.style.setProperty('--rx', `${(-y * 8).toFixed(2)}deg`);
        portrait.style.setProperty('--ry', `${(x * 8).toFixed(2)}deg`);
      },
      { passive: true },
    );
    tilt.addEventListener('pointerleave', () => {
      portrait.style.setProperty('--rx', '0deg');
      portrait.style.setProperty('--ry', '0deg');
    });
  }
</script>
