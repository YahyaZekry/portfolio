---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { profile, ui } from '../data/profile';
---

<Layout title={`${ui.notFound.title} | ${profile.name}`} noindex>
  <main class="mx-auto flex min-h-screen max-w-7xl flex-col justify-center px-6 py-12 font-sans md:px-12 md:py-16 lg:py-24">
    <!-- The packet for this page never arrived: two tables hold, one wire broke. -->
    <svg viewBox="0 0 600 150" class="mb-10 w-full max-w-lg" aria-hidden="true" focusable="false">
      <!-- table fragments -->
      <g fill="none" stroke="var(--color-line-strong)">
        <rect x="14" y="47" width="120" height="56" rx="10" />
        <rect x="240" y="47" width="120" height="56" rx="10" />
        <rect x="466" y="47" width="120" height="56" rx="10" />
      </g>
      <g stroke="var(--color-line)">
        <line x1="28" y1="66" x2="120" y2="66" />
        <line x1="28" y1="80" x2="120" y2="80" />
        <line x1="254" y1="66" x2="346" y2="66" />
        <line x1="254" y1="80" x2="346" y2="80" />
        <line x1="480" y1="66" x2="572" y2="66" />
        <line x1="480" y1="80" x2="572" y2="80" />
      </g>
      <!-- healthy wire -->
      <path
        d="M 134 75 C 175 88, 199 88, 240 75"
        fill="none"
        stroke="var(--color-accent)"
        stroke-opacity="0.5"
        stroke-width="1.5"
      ></path>
      <!-- the broken one: two frayed stubs and a gap -->
      <path
        d="M 360 75 C 392 83, 412 84, 430 80"
        fill="none"
        stroke="var(--color-accent)"
        stroke-opacity="0.5"
        stroke-width="1.5"
      ></path>
      <path
        d="M 450 74 C 457 72, 461 71, 466 71"
        fill="none"
        stroke="var(--color-accent)"
        stroke-opacity="0.5"
        stroke-width="1.5"
      ></path>
      <g stroke="var(--color-accent)" stroke-opacity="0.3">
        <line x1="431" y1="80" x2="440" y2="72" />
        <line x1="433" y1="83" x2="441" y2="83" />
        <line x1="449" y1="75" x2="441" y2="68" />
      </g>
      <!-- the packet that never made it across -->
      <circle class="spark" r="3" fill="var(--color-accent)"></circle>
      <text class="q-mark" x="437" y="62" text-anchor="middle" fill="var(--color-muted)" font-size="15">
        ?
      </text>
    </svg>

    <p class="text-sm font-bold tracking-widest text-accent uppercase">{ui.notFound.code}</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.025em] text-ink sm:text-5xl">{ui.notFound.title}</h1>
    <p class="mt-4 max-w-md leading-normal">{ui.notFound.body}</p>
    <a class="group/link mt-8 inline-flex w-max items-center font-semibold leading-tight text-accent" href="/">
      <Icon
        name="arrow-left"
        class="mr-1 h-4 w-4 transition-transform group-hover/link:-translate-x-2 group-focus-visible/link:-translate-x-2 motion-reduce:transition-none"
      />
      {ui.notFound.back}
    </a>
  </main>
</Layout>

<style>
  .spark {
    offset-path: path('M 360 75 C 392 83, 412 84, 430 80');
    offset-rotate: 0deg;
    opacity: 0;
  }

  .q-mark {
    opacity: 0.25;
  }

  @media (prefers-reduced-motion: no-preference) {
    .spark {
      animation: spark-fizzle 2.8s ease-in-out infinite;
    }

    .q-mark {
      animation: q-blink 2.8s ease-in-out infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spark {
      display: none;
    }

    .q-mark {
      opacity: 0.6;
    }
  }

  @keyframes spark-fizzle {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    12% {
      opacity: 0.9;
    }
    70% {
      offset-distance: 100%;
      opacity: 0.9;
    }
    85%,
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  @keyframes q-blink {
    0%,
    55%,
    100% {
      opacity: 0.25;
    }
    72% {
      opacity: 0.9;
    }
  }
</style>
