---
import Layout from '../layouts/Layout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ProjectItem from '../components/ProjectItem.astro';
import RichText from '../components/RichText.astro';
import SchemaDiagram from '../components/SchemaDiagram.astro';
import Section from '../components/Section.astro';
import Spotlight from '../components/Spotlight.astro';
import { about, experience, profile, projects, schema, ui } from '../data/profile';

const [aboutSection, experienceSection, projectsSection, schemaSection] = ui.sections;
---

<Layout>
  <div class="relative">
    <Spotlight />
    <div class="mx-auto min-h-screen max-w-7xl px-6 py-12 font-sans md:px-12 md:py-16 lg:py-0">
      <a
        href="#content"
        class="absolute top-0 left-0 z-50 block -translate-x-full rounded-full bg-accent px-4 py-3 text-sm font-bold tracking-widest text-accent-ink uppercase focus-visible:translate-x-0"
      >
        {ui.skipLink}
      </a>
      <div class="lg:flex lg:justify-between lg:gap-4">
        <Header sections={ui.sections} />

        <div class="pt-24 lg:w-[52%] lg:py-24">
          <main id="content">
            <Section {...aboutSection}>
              <div data-reveal-group>
                {about.map((paragraph, i) => (
                  <div class={`${i === 0 ? 'mb-5' : 'mb-4'} last:mb-0`} data-reveal>
                    <RichText source={paragraph} class={i === 0 ? 'text-lg leading-relaxed' : undefined} />
                  </div>
                ))}
              </div>
            </Section>

            <Section {...experienceSection}>
              <ol>
                {experience.map((item) => (
                  <ExperienceItem item={item} />
                ))}
              </ol>
              <div class="mt-12" data-reveal>
                <ArrowLink href={profile.resume} lead={ui.resume.lead} last={ui.resume.last} external />
              </div>
            </Section>

            <Section {...projectsSection}>
              <ul>
                {projects.map((item, i) => (
                  <ProjectItem item={item} index={i} />
                ))}
              </ul>
            </Section>

            <Section {...schemaSection}>
              <p class="mb-8 max-w-2xl leading-relaxed" data-reveal>
                {schema.lead}
              </p>
              <SchemaDiagram />
            </Section>
          </main>

          <Footer />
        </div>
      </div>
    </div>
  </div>
</Layout>
